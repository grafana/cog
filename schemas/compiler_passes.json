{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/grafana/cog/main/schemas/compiler_passes.json",
  "$ref": "#/$defs/YamlTransforms",
  "$defs": {
    "IrArrayType": {
      "properties": {
        "value_type": {
          "$ref": "#/$defs/IrType"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/IrTypeConstraint"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IrComposableSlotType": {
      "properties": {
        "variant": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IrConstantReferenceType": {
      "properties": {
        "referred_pkg": {
          "type": "string"
        },
        "referred_type": {
          "type": "string"
        },
        "reference_value": true
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IrDisjunctionType": {
      "properties": {
        "branches": {
          "$ref": "#/$defs/IrTypes"
        },
        "discriminator": {
          "type": "string",
          "description": "If the branches are references to structs, some languages will need\nextra context to be able to distinguish between them. Golang, for\nexample, doesn't support sum types (disjunctions of fixed types).\nTo emulate sum types for these languages, we need a way to\ndiscriminate against every possible type.\n\nTo do that, we need two things:\n\t- a discriminator: the name of a field that is present in all types.\n\t  The value of which identifies the type being used.\n - a mapping: associating a \"discriminator value\" to a type."
        },
        "discriminator_mapping": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IrEnumType": {
      "properties": {
        "values": {
          "items": {
            "$ref": "#/$defs/IrEnumValue"
          },
          "type": "array",
          "description": "possible values. Value types might be different"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IrEnumValue": {
      "properties": {
        "type": {
          "$ref": "#/$defs/IrType"
        },
        "name": {
          "type": "string"
        },
        "value": true
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IrIntersectionType": {
      "properties": {
        "branches": {
          "items": {
            "$ref": "#/$defs/IrType"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IrJenniesHints": {
      "type": "object",
      "description": "JenniesHints meant to be used by jennies, to gain a finer control on the codegen from schemas"
    },
    "IrMapType": {
      "properties": {
        "indextype": {
          "$ref": "#/$defs/IrType"
        },
        "valuetype": {
          "$ref": "#/$defs/IrType"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IrRefType": {
      "properties": {
        "referred_pkg": {
          "type": "string"
        },
        "referred_type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IrScalarType": {
      "properties": {
        "scalar_kind": {
          "type": "string",
          "description": "bool, bytes, string, int, float, ..."
        },
        "value": {
          "description": "if value isn't nil, we're representing a constant scalar"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/IrTypeConstraint"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IrStructField": {
      "properties": {
        "name": {
          "type": "string"
        },
        "comments": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "$ref": "#/$defs/IrType"
        },
        "required": {
          "type": "boolean"
        },
