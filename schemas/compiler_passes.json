      "additionalProperties": false,
      "type": "object"
    },
    "IrType": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "nullable": {
          "type": "boolean"
        },
        "default": true,
        "disjunction": {
          "$ref": "#/$defs/IrDisjunctionType"
        },
        "array": {
          "$ref": "#/$defs/IrArrayType"
        },
        "enum": {
          "$ref": "#/$defs/IrEnumType"
        },
        "map": {
          "$ref": "#/$defs/IrMapType"
        },
        "struct": {
          "$ref": "#/$defs/IrStructType"
        },
        "ref": {
          "$ref": "#/$defs/IrRefType"
        },
        "constant_ref": {
          "$ref": "#/$defs/IrConstantReferenceType"
        },
        "scalar": {
          "$ref": "#/$defs/IrScalarType"
        },
        "intersection": {
          "$ref": "#/$defs/IrIntersectionType"
        },
        "composable_slot": {
          "$ref": "#/$defs/IrComposableSlotType"
        },
        "hints": {
          "$ref": "#/$defs/IrJenniesHints"
        },
        "passestrail": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Type representing every type defined by the IR."
    },
    "IrTypeConstraint": {
      "properties": {
        "op": {
          "type": "string"
        },
        "args": {
          "items": true,
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IrTypes": {
      "items": {
        "$ref": "#/$defs/IrType"
      },
      "type": "array"
    },
