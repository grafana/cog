          "type": "string"
        },
        "builder": {
          "type": "string"
        },
        "factory": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IrIntersectionType": {
      "properties": {
        "branches": {
          "items": {
            "$ref": "#/$defs/IrType"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IrJenniesHints": {
      "type": "object",
      "description": "JenniesHints meant to be used by jennies, to gain a finer control on the codegen from schemas"
